			const productsGrid = document.getElementById('product-container');

function renderProducts(products) {
  productsGrid.innerHTML = ''; // Clear the current products

  if (products.length === 0) {
    productsGrid.innerHTML = `
      <div class="col-12 text-center p-5">
        <h3 class="text-muted">No products found</h3>
      </div>
    `;
    return;
  }

  products.forEach(product => {
    if (product.status === true) {
      const stockBadgeColor = product.stock === 0 ? 'bg-danger' : product.stock < 10 ? 'bg-warning' : 'bg-success';
      const stockText = product.stock === 0 ? 'Out of Stock' : product.stock < 10 ? 'Limited Stock' : 'In Stock';

      const productHTML = `
        <div class="col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item ${product.category?.name || ''}">
          <div class="block2">
            <div class="block2-pic hov-img0 position-relative">
              <img src="/uploads/${product.image[0]}" alt="${product.name}" class="img-fluid">
              <a href="#" class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04 js-show-modal1">
                Quick View
              </a>
              <span class="position-absolute top-0 end-0 m-2 badge ${stockBadgeColor}">${stockText}</span>
            </div>
            <div class="block2-txt flex-w flex-t p-t-14">
              <div class="block2-txt-child1 flex-col-l">
                <a href="/product-detail/${product._id}" class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6">
                  ${product.name}
                </a>
                <span class="stext-105 cl3">
                  ₹${product.price}
                  ${product.offerPrice ? `<span class="text-decoration-line-through ms-2">₹${product.offerPrice}</span>` : ''}
                  ${product.category?.offerPrice ? `<span class="badge bg-danger ms-2">${product.category.offerPrice} Off</span>` : ''}
                </span>
              </div>
              <div class="block2-txt-child2 flex-r p-t-3">
                <a href="#" class="btn-addwish-b2 dis-block pos-relative js-addwish-b2" data-id="${product._id}">
                  <img class="icon-heart1 dis-block trans-04" src="/images/icons/icon-heart-01.png" alt="ICON">
                  <img class="icon-heart2 dis-block trans-04 ab-t-l" src="/images/icons/icon-heart-02.png" alt="ICON">
                </a>
              </div>
            </div>
          </div>
        </div>
      `;
      productsGrid.innerHTML += productHTML;
    }
  });
}

