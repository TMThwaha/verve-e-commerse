											style="text-decoration: none;">
											All
										</a>
									</li>
									<% brand.forEach(element=> { %>

										<li class="p-b-6">
											<a href="#" class="filter-link stext-106 trans-04"
												style="text-decoration: none;display: flex;justify-content:flex-start;">
												<input type="checkbox" id="SelectedBrand" value="<%= element.name %>">
												<%= element.name %>
											</a>
										</li>
										<% }) %>
								</ul>
							</div>
							<div class="filter-col2 p-r-15 p-b-27">
