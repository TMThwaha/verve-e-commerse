											All
										</a>
									</li>
									<li class="p-b-6">
										<a href="#" class="filter-link stext-106 trans-04"
											style="text-decoration: none;display: flex;justify-content:flex-start;">
											<input type="checkbox" id="SelectedPrice">

											$0.00 - $50.00
										</a>
									</li>
									<li class="p-b-6">
										<a href="#" class="filter-link stext-106 trans-04"
											style="text-decoration: none;display: flex;justify-content:flex-start;">
											<input type="checkbox" id="SelectedPrice">
											$50.00 - $100.00
										</a>
									</li>
									<li class="p-b-6">
										<a href="#" class="filter-link stext-106 trans-04"
											style="text-decoration: none;display: flex;justify-content:flex-start;">
											<input type="checkbox" id="SelectedPrice">
											$100.00 - $150.00
										</a>
									</li>
									<li class="p-b-6">
										<a href="#" class="filter-link stext-106 trans-04"
											style="text-decoration: none;display: flex;justify-content:flex-start;">
											<input type="checkbox" id="SelectedPrice">
											$150.00 - $200.00
										</a>
									</li>
									<li class="p-b-6">
