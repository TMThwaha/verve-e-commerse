											style="text-decoration: none;display: flex;justify-content:flex-start;">
											<input type="checkbox" id="SelectedPrice">
											$200.00+
										</a>
									</li>
								</ul>
								<button id="applyFilter"
									style="background-color:rgb(61, 136, 234);border-radius: 10px;width: 200px;height: 30px;color: aliceblue;">Apply</button>
							</div>
